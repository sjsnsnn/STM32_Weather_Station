@startuml
title 菜单状态机 —— 三页循环切换

state "光照页\nPAGE_LIGHT (0)" as LIGHT
state "温度页\nPAGE_TEMP (1)" as TEMP
state "系统页\nPAGE_SYSTEM (2)" as SYSTEM

[*] --> LIGHT : 上电初始化\ncurrentPage = PAGE_LIGHT

LIGHT --> TEMP : BTN_RIGHT
TEMP --> SYSTEM : BTN_RIGHT
SYSTEM --> LIGHT : BTN_RIGHT

LIGHT --> SYSTEM : BTN_LEFT
SYSTEM --> TEMP : BTN_LEFT
TEMP --> LIGHT : BTN_LEFT

note right of SYSTEM
  实际实现：枚举 + 取模
  BTN_RIGHT: (page + 1) % 3
  BTN_LEFT:  (page + 2) % 3
end note

@enduml
